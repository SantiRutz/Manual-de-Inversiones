# Normaliza los finales de línea a LF en todos los sistemas.
* text=auto eol=lf

# Scripts de Windows: se conservan con CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binarios: Git no los toca.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
*.zip binary
*.gz binary
*.jar binary
*.apk binary
*.dex binary
*.jks binary
*.mp3 binary
*.mp4 binary
*.webm binary
